{
  "name": "fixit-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --android",
    "start:mock": "cross-env EXPO_PUBLIC_USE_MOCKS=true expo start"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@gorhom/bottom-sheet": "latest",
    "@hookform/resolvers": "^7.0.6",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@storybook/addon-ondevice-actions": "latest",
    "@storybook/addon-ondevice-controls": "latest",
    "@storybook/react-native": "latest",
    "@storybook/react-native-ui-lite": "latest",
    "@tanstack/react-query": "^5.107.1",
    "cross-env": "latest",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.69.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "storybook": "^10.6.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@storybook/addon-ondevice-backgrounds": "^10.7.1",
    "@storybook/react": "^10.6.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@storybook/.*|storybook)"
    ]
  }
}
